<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>张三</title>
<style>
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #0d1117;
    font-family: "PingFang SC", "Microsoft YaHei", "Noto Sans SC", sans-serif;
    overflow: hidden;
  }

  /* 背景光晕 */
  .bg-orb {
    position: fixed;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.15;
    animation: orbFloat 12s ease-in-out infinite alternate;
    pointer-events: none;
  }
  .bg-orb:nth-child(1) {
    width: 500px; height: 500px;
    background: #8b5cf6;
    top: -150px; left: -100px;
    animation-delay: 0s;
  }
  .bg-orb:nth-child(2) {
    width: 400px; height: 400px;
    background: #6366f1;
    bottom: -120px; right: -80px;
    animation-delay: -4s;
  }
  .bg-orb:nth-child(3) {
    width: 300px; height: 300px;
    background: #a78bfa;
    top: 50%; left: 60%;
    animation-delay: -8s;
  }

  @keyframes orbFloat {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(30px, -40px) scale(1.15); }
  }

  .card {
    position: relative;
    z-index: 1;
    text-align: center;
    animation: fadeUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: 0.2s;
  }

  @keyframes fadeUp {
    0% {
      opacity: 0;
      transform: translateY(40px);
      filter: blur(4px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  h1 {
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #f8fafc;
    margin-bottom: 0.25em;
    background: linear-gradient(135deg, #e0e7ff 0%, #a5b4fc 40%, #c4b5fd 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .tagline {
    font-size: clamp(1rem, 2.5vw, 1.2rem);
    color: #94a3b8;
    font-weight: 300;
    letter-spacing: 0.04em;
    margin-bottom: 2.5rem;
    animation: fadeUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: 0.45s;
  }

  .tagline span { margin: 0 0.3em; }
  .tagline .sep { color: #475569; }

  .links {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    animation: fadeUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: 0.65s;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.6em 1.6em;
    border: 1px solid rgba(148, 163, 184, 0.25);
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.03);
    color: #cbd5e1;
    font-size: 0.95rem;
    text-decoration: none;
    letter-spacing: 0.03em;
    backdrop-filter: blur(10px);
    transition: all 0.3s ease;
  }

  .btn:hover {
    border-color: rgba(139, 92, 246, 0.5);
    background: rgba(139, 92, 246, 0.12);
    color: #e2e8f0;
    box-shadow: 0 0 30px rgba(139, 92, 246, 0.15);
    transform: translateY(-2px);
  }

  .btn svg {
    width: 18px; height: 18px;
    opacity: 0.8;
  }
</style>
</head>
<body>
  <div class="bg-orb"></div>
  <div class="bg-orb"></div>
  <div class="bg-orb"></div>

  <main class="card">
    <h1>张三</h1>
    <p class="tagline">
      写字的人<span class="sep">/</span>咖啡上瘾<span class="sep">/</span>在学 AI
    </p>
    <nav class="links">
      <a href="#" class="btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
        GitHub
      </a>
      <a href="#" class="btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        Twitter
      </a>
      <a href="#" class="btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
        微博
      </a>
    </nav>
  </main>
</body>
</html>
