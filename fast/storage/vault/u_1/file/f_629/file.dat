+---%0Atitle: %22Python asyncio %E4%BD%BF%E7%94%A8%E6%8C%87%E5%8D%97%22%0Atags: %5B%22python%22, %22async%22, %22asyncio%22%5D%0Acreated: 2026-06-20%0A---%0A%0A# Python asyncio %E4%BD%BF%E7%94%A8%E6%8C%87%E5%8D%97%0A%0A## %E9%97%AE%E9%A2%98%0A%0APython %E5%A4%84%E7%90%86%E5%A4%A7%E9%87%8F IO %E5%AF%86%E9%9B%86%E5%9E%8B%E4%BB%BB%E5%8A%A1%EF%BC%88%E7%BD%91%E7%BB%9C%E8%AF%B7%E6%B1%82%E3%80%81%E6%96%87%E4%BB%B6%E8%AF%BB%E5%86%99%EF%BC%89%E6%97%B6%EF%BC%8C%E5%A4%9A%E7%BA%BF%E7%A8%8B%E5%BC%80%E9%94%80%E5%A4%A7%E4%B8%94%E5%AE%B9%E6%98%93%E5%87%BA%E9%94%99%E3%80%82%E9%9C%80%E8%A6%81%E4%B8%80%E7%A7%8D%E9%AB%98%E6%95%88%E7%9A%84%E5%B9%B6%E5%8F%91%E6%96%B9%E6%A1%88%E3%80%82%0A%0A## %E6%96%B9%E6%A1%88%0A%0A%E4%BD%BF%E7%94%A8 Python %E7%9A%84 asyncio %E5%BA%93%E5%AE%9E%E7%8E%B0%E5%BC%82%E6%AD%A5 IO%EF%BC%8C%E9%80%9A%E8%BF%87%E4%BA%8B%E4%BB%B6%E5%BE%AA%E7%8E%AF%EF%BC%88event loop%EF%BC%89%E5%8D%95%E7%BA%BF%E7%A8%8B%E5%A4%84%E7%90%86%E5%B9%B6%E5%8F%91%E4%BB%BB%E5%8A%A1%E3%80%82%0A%0A## %E6%A0%B8%E5%BF%83%E6%A6%82%E5%BF%B5%0A%0A- **coroutine**: %E7%94%A8 %60async def%60 %E5%AE%9A%E4%B9%89%E7%9A%84%E5%87%BD%E6%95%B0%EF%BC%8C%E5%8F%AF%E4%BB%A5%E8%A2%AB%E7%AD%89%E5%BE%85%0A- **event loop**: %E4%BA%8B%E4%BB%B6%E5%BE%AA%E7%8E%AF%EF%BC%8C%E8%B0%83%E5%BA%A6%E5%92%8C%E6%89%A7%E8%A1%8C%E5%8D%8F%E7%A8%8B%0A- **task**: %E5%B0%86%E5%8D%8F%E7%A8%8B%E5%8C%85%E8%A3%85%E6%88%90 Task %E6%8F%90%E4%BA%A4%E7%BB%99%E4%BA%8B%E4%BB%B6%E5%BE%AA%E7%8E%AF%0A- **await**: %E7%AD%89%E5%BE%85%E4%B8%80%E4%B8%AA%E5%8D%8F%E7%A8%8B%E5%AE%8C%E6%88%90%EF%BC%8C%E4%BA%A4%E5%87%BA%E6%8E%A7%E5%88%B6%E6%9D%83%E7%BB%99%E4%BA%8B%E4%BB%B6%E5%BE%AA%E7%8E%AF%0A%0A## %E4%BB%A3%E7%A0%81%0A%0A%60%60%60python%0Aimport asyncio%0A%0Aasync def fetch_data(url: str) -%3E str:%0A    await asyncio.sleep(1)  # %E6%A8%A1%E6%8B%9F%E7%BD%91%E7%BB%9C%E8%AF%B7%E6%B1%82%0A    return f%22Data from %7Burl%7D%22%0A%0Aasync def main():%0A    urls = %5Bf%22https://api.example.com/%7Bi%7D%22 for i in range(10)%5D%0A    tasks = %5Bfetch_data(url) for url in urls%5D%0A    results = await asyncio.gather(*tasks)%0A    for r in results:%0A        print(r)%0A%0Aasyncio.run(main())%0A%60%60%60%0A%0A## %E6%B3%A8%E6%84%8F%E4%BA%8B%E9%A1%B9%0A%0A- %E4%B8%8D%E8%A6%81%E5%9C%A8%E5%8D%8F%E7%A8%8B%E4%B8%AD%E4%BD%BF%E7%94%A8%E9%98%BB%E5%A1%9E%E8%B0%83%E7%94%A8%EF%BC%88%E5%A6%82 %60time.sleep%60%EF%BC%89%EF%BC%8C%E7%94%A8 %60await asyncio.sleep%60 %E4%BB%A3%E6%9B%BF%0A- CPU %E5%AF%86%E9%9B%86%E5%9E%8B%E4%BB%BB%E5%8A%A1%E4%B8%8D%E9%80%82%E5%90%88 asyncio%EF%BC%8C%E5%BA%94%E8%AF%A5%E7%94%A8 multiprocessing%0A- Python 3.11+ %E7%9A%84 asyncio %E6%80%A7%E8%83%BD%E6%9C%89%E6%98%BE%E8%91%97%E6%8F%90%E5%8D%87%0A%0A## %E5%8F%82%E8%80%83%0A%0A- %5BPython asyncio %E5%AE%98%E6%96%B9%E6%96%87%E6%A1%A3%5D(https://docs.python.org/3/library/asyncio.html)%0A
